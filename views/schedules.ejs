<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Railway Management System</title>
    <style>
        body {
            background: #f2f2f2;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .container {
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0px 0px 15px rgba(0, 0, 0, 0.2);
            max-width: 900px;
            margin: 20px auto;
        }

        h1 {
            text-align: center;
            margin-bottom: 20px;
            color: #333;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            padding: 12px;
            border-bottom: 1px solid #ddd;
            text-align: center;
        }

        th {
            background-color: #4CAF50;
            color: white;
        }

        tr:hover {
            background-color: #f5f5f5;
        }

        .btn {
            padding: 8px 15px;
            margin: 0 5px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 14px;
        }

        .edit-btn {
            background-color: #2196F3;
            color: white;
        }

        .delete-btn {
            background-color: #f44336;
            color: white;
        }

        .add-form {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 20px;
            gap: 10px;
        }

        .add-input {
            padding: 10px;
            font-size: 16px;
            border: 1px solid #ccc;
            border-radius: 5px;
            width: 250px;
        }

        .add-btn {
            background-color: #4CAF50;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
        }

        .add-btn:hover {
            background-color: #45a049;
        }

        .dashboard-wrapper {
            text-align: center;
            margin-top: 30px;
        }

        .dashboard-btn {
            background-color: #4CAF50;
            color: white;
            padding: 10px 16px;
            border: none;
            border-radius: 5px;
            font-size: 14px;
            cursor: pointer;
        }

        .dashboard-btn:hover {
            background-color: #45a049;
        }
    </style>
</head>
<body>

<div class="container">
    <h1>Schedule</h1>

    <table>
        <thead>
            <tr>
                <th>Trainno</th>
                <th>Date of Journey</th>
                <th>Class</th>
                <th>Fare</th>
                <th>Seats Left</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% schedules.forEach(function(schedule) { %>
                <tr>
                    <td><%= schedule.trainno %></td>
                    <td><%= schedule.doj.toLocaleDateString('en-CA') %></td>
                    <td><%=schedule.class %></td>
                    <td><%=schedule.fare %></td>
                    <td><%=schedule.seatsleft %></td>
                    <td>
                        <button class="btn edit-btn" onclick="editSchedule('<%= schedule.trainno %>', '<%= schedule.doj.toLocaleDateString('en-CA') %>', '<%=schedule.class %>')">Edit</button>
                        <form action="/admin/deleteClassseat" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this schedule?');">
                            <input type="hidden" name="trainno" value="<%= schedule.trainno %>">
                            <input type="hidden" name="doj" value="<%= schedule.doj.toLocaleDateString('en-CA') %>">
                            <input type="hidden" name="classs" value="<%= schedule.class %>">
                            <button type="submit" class="btn delete-btn">Delete</button>
                        </form>                          
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <div class="dashboard-wrapper">
        <button class="dashboard-btn" onclick="goToDashboard()">Go to Dashboard</button>
    </div>
</div>

<script>
    function editSchedule(trainno,date,classs) {
        const fare = prompt("Enter the new fare:");
        const seats = prompt("Enter the seatsleft:");

        if (fare && fare.trim() !== "" && seats && seats.trim() !== "") {
            fetch('/admin/editClassseat', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    trainno: trainno,
                    doj: date,
                    fare: fare.trim(),
                    seatsleft: seats.trim(),
                    classs: classs
                })
            })
            .then(response => {
                if (response.ok) {
                    alert('Schedule updated successfully!');
                    window.location.reload();
                } else {
                    alert('Failed to update schedule.');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred.');
            });
        }
    }
    function goToDashboard() {
    window.location.href = "/admin/getDashboard";
    }
</script>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Railway Management System</title>
    <style>
        body {
            background: #f2f2f2;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .container {
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0px 0px 15px rgba(0, 0, 0, 0.2);
            max-width: 900px;
            margin: 20px auto;
        }

        h1 {
            text-align: center;
            margin-bottom: 20px;
            color: #333;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            padding: 12px;
            border-bottom: 1px solid #ddd;
            text-align: center;
        }

        th {
            background-color: #4CAF50;
            color: white;
        }

        tr:hover {
            background-color: #f5f5f5;
        }

        .btn {
            padding: 8px 15px;
            margin: 0 5px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 14px;
        }

        .edit-btn {
            background-color: #2196F3;
            color: white;
        }

        .delete-btn {
            background-color: #f44336;
            color: white;
        }

        .add-form {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 20px;
            gap: 10px;
        }

        .add-input {
            padding: 10px;
            font-size: 16px;
            border: 1px solid #ccc;
            border-radius: 5px;
            width: 250px;
        }

        .add-btn {
            background-color: #4CAF50;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
        }

        .add-btn:hover {
            background-color: #45a049;
        }

        .bottom-btn-container {
            display: flex;
            justify-content: center;
            margin-top: 30px;
        }

        .dashboard-btn {
            background-color: #4CAF50;
            color: white;
            padding: 10px 25px;
            font-size: 16px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        .dashboard-btn:hover {
            background-color: #45a049;
        }
    </style>
</head>
<body>

<div class="container">
    <h1>Stations</h1>

    <!-- Add New Station Form -->
    <form action="/admin/enterNewStation" method="POST" class="add-form">
        <input type="text" name="sname" placeholder="Enter New Station Name" class="add-input" required>
        <button type="submit" class="add-btn">Add New Station</button>
    </form>

    <!-- Stations Table -->
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Station Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% stations.forEach(function(station) { %>
                <tr>
                    <td><%= station.id %></td>
                    <td><%= station.sname %></td>
                    <td>
                        <button class="btn edit-btn" onclick="editStation(<%= station.id %>)">Edit</button>
                        <form action="/admin/deleteStation" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this station?');"><input type="hidden" name="id" value="<%= station.id %>"><button type="submit" class="btn delete-btn">Delete</button></form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <!-- ✅ Bottom Go To Dashboard Button -->
    <div class="bottom-btn-container">
        <button class="dashboard-btn" onclick="goToDashboard()">Go To Dashboard</button>
    </div>
</div>

<script>
    function editStation(stationId) {
        const newName = prompt("Enter the new station name:");

        if (newName && newName.trim() !== "") {
            fetch('/admin/editStation', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    id: stationId,
                    sname: newName.trim()
                })
            })
            .then(response => {
                if (response.ok) {
                    alert('Station updated successfully!');
                    window.location.reload();
                } else {
                    alert('Failed to update station.');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred.');
            });
        }
    }

    function goToDashboard() {
        window.location.href = "/admin/getDashboard";
    }
</script>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Railway Management Systems</title>
    <style>
        body {
            background: #f2f2f2;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .dashboard-container {
            background: white;
            padding: 40px 30px;
            border-radius: 10px;
            box-shadow: 0px 0px 15px rgba(0, 0, 0, 0.2);
            width: 400px;
            text-align: center;
        }
        h1 {
            margin-bottom: 30px;
            color: #333;
        }
        .dashboard-button {
            width: 100%;
            padding: 12px;
            margin: 10px 0;
            background-color: #4CAF50;
            border: none;
            color: white;
            font-size: 16px;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s;
        }
        .dashboard-button:hover {
            background-color: #45a049;
        }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <h1>User Dashboard</h1>
        <button class="dashboard-button" onclick="location.href='/user/getEnquiryPage'">Enquiry</button>
        <button class="dashboard-button" onclick="location.href='/user/userTickets'">View Tickets</button>
        <!-- <button class="dashboard-button" onclick="location.href='/user/'">View Cancelled Tickets</button> -->
        <!-- <button class="dashboard-button" onclick="location.href='/user/'">Settings</button> -->
        <button class="dashboard-button" onclick="location.href='/user/userLogout'">Logout</button>
    </div>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Reserved Tickets - Railway Management System</title>
    <style>
        body {
            background: #f2f2f2;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .container {
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0px 0px 15px rgba(0, 0, 0, 0.2);
            max-width: 1000px;
            margin: 20px auto;
        }

        h1 {
            text-align: center;
            margin-bottom: 20px;
            color: #333;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            padding: 12px;
            border-bottom: 1px solid #ddd;
            text-align: center;
        }

        th {
            background-color: #4CAF50;
            color: white;
        }

        tr:hover {
            background-color: #f5f5f5;
        }

        .btn {
            padding: 8px 15px;
            margin: 0 5px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 14px;
        }

        .edit-btn {
            background-color: #2196F3;
            color: white;
        }

        .delete-btn {
            background-color: #f44336;
            color: white;
        }

        .bottom-btn-container {
            display: flex;
            justify-content: center;
            margin-top: 30px;
        }

        .dashboard-btn {
            background-color: #4CAF50;
            color: white;
            padding: 10px 25px;
            font-size: 16px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        .dashboard-btn:hover {
            background-color: #45a049;
        }
    </style>
</head>
<body>

<div class="container">
    <h1>Reserved Tickets</h1>

    <!-- Tickets Table -->
    <table>
        <thead>
            <tr>
                <th>PNR</th>
                <th>Train No</th>
                <th>SP</th>
                <th>DP</th>
                <th>Date of Journey</th>
                <th>Fare</th>
                <th>Class</th>
                <th>No of Seats</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% reservedTickets.forEach(function(ticket) { %>
                <tr>
                    <td><%= ticket.pnr %></td>
                    <td><%= ticket.trainno %></td>
                    <td><%= ticket.sp %></td>
                    <td><%= ticket.dp %></td>
                    <td><%= ticket.doj.toLocaleDateString('en-CA') %></td>
                    <td><%= ticket.tfare %></td>
                    <td><%= ticket.class %></td>
                    <td><%= ticket.nos %></td>
                    <td><%= ticket.status %></td>
                    <td>
                        <!-- <form action="/admin/deleteTicket" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this reservation?');">
                            <input type="hidden" name="pnr" value="<%= ticket.pnr %>">
                            <button type="submit" class="btn delete-btn">Cancel</button>
                        </form> -->
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
    <div class="bottom-btn-container">
        <button class="dashboard-btn" onclick="goToDashboard()">Go To Dashboard</button>
    </div>
</div>

<script>
    function goToDashboard() {
        window.location.href = "/user/getDashboard";
    }
</script>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Railway Management System</title>
    <style>
        body {
            background: #f2f2f2;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .container {
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0px 0px 15px rgba(0, 0, 0, 0.2);
            max-width: 900px;
            margin: 20px auto;
        }

        h1 {
            text-align: center;
            margin-bottom: 20px;
            color: #333;
        }

        .dashboard-wrapper {
            text-align: center;
            margin-top: 30px;
        }

        .dashboard-btn {
            background-color: #4CAF50;
            color: white;
            padding: 10px 16px;
            border: none;
            border-radius: 5px;
            font-size: 14px;
            cursor: pointer;
        }

        .dashboard-btn:hover {
            background-color: #45a049;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            padding: 12px;
            border-bottom: 1px solid #ddd;
            text-align: center;
        }

        th {
            background-color: #4CAF50;
            color: white;
        }

        tr:hover {
            background-color: #f5f5f5;
        }

        .btn {
            padding: 8px 15px;
            margin: 0 5px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 14px;
        }

        .edit-btn {
            background-color: #2196F3;
            color: white;
        }

        .delete-btn {
            background-color: #f44336;
            color: white;
        }

        .add-form {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 20px;
            gap: 10px;
            flex-wrap: wrap;
        }

        .add-input {
            padding: 10px;
            font-size: 16px;
            border: 1px solid #ccc;
            border-radius: 5px;
            width: 250px;
        }

        .add-btn {
            background-color: #4CAF50;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
        }

        .add-btn:hover {
            background-color: #45a049;
        }
    </style>
</head>
<body>

<div class="container">
    <h1>Users</h1>

    <!-- Add New User Form -->
    <form action="/admin/enterNewUser" method="POST" class="add-form">
        <input type="email" class="form-control" name="emailid" placeholder="Email" required>
        <input type="password" class="form-control" name="password" placeholder="Password" required>
        <input type="text" class="form-control" name="mobileno" placeholder="Mobile No" required>
        <input type="date" class="form-control" name="dob" required>
        <button type="submit" class="add-btn">Add New User</button>
    </form>

    <!-- Users Table -->
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Email</th>
                <th>Mobile No</th>
                <th>Date of Birth</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% users.forEach(function(user) { %>
                <tr>
                    <td><%= user.id %></td>
                    <td><%= user.emailid %></td>
                    <td><%= user.mobileno %></td>
                    <td><%= user.dob.toISOString().split('T')[0] %></td>
                    <td>
                        <button class="btn edit-btn" onclick="editUser(<%= user.id %>)">Edit</button>
                        <form action="/admin/deleteUser" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this user?');">
                            <input type="hidden" name="id" value="<%= user.id %>">
                            <button type="submit" class="btn delete-btn">Delete</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <!-- Dashboard Button at Bottom -->
    <div class="dashboard-wrapper">
            <button class="dashboard-btn" onclick="goToDashboard()">Go to Dashboard</button>
    </div>
</div>

<script>
    function editUser(userId) {
        const newmobileno = prompt("Enter the new Mobile No:");
        const newEmail = prompt("Enter the new Email:");

        if (newmobileno && newmobileno.trim() !== "" && newEmail && newEmail.trim() !== "") {
            fetch('/admin/editUser', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    id: userId,
                    mobileno: newmobileno.trim(),
                    emailid: newEmail.trim()
                })
            })
            .then(response => {
                if (response.ok) {
                    alert('User updated successfully!');
                    window.location.reload();
                } else {
                    alert('Failed to update user.');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred.');
            });
        }
    }

    function goToDashboard() {
    window.location.href = "/admin/getDashboard";
    }
</script>

</body>
</html>
